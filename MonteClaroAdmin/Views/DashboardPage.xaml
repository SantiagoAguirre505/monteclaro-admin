<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonteClaroAdmin.Views.DashboardPage"
             BackgroundColor="#F4F0EB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BackgroundColor="#1E4039" StrokeThickness="0">
            <VerticalStackLayout Padding="14,16" Spacing="18">
                <HorizontalStackLayout Spacing="10" Padding="0,4,0,10">
                    <Border WidthRequest="30" HeightRequest="30" BackgroundColor="#F0EAE4" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Label Text="M" FontSize="16" FontAttributes="Bold" TextColor="#1E4039" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout>
                        <Label Text="Monte Claro" FontAttributes="Bold" FontSize="18" TextColor="White" />
                        <Label Text="ASERRADERO · CORRIENTES" FontSize="9" TextColor="#D8E2DF" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label Text="OPERACIONES" FontSize="11" TextColor="#C8D5D1" Margin="8,0,0,8" />
                <Label Text="Resumen" FontSize="14" TextColor="White" Padding="12,10" BackgroundColor="#2E5A4E" />
                <Label Text="Inventario" FontSize="14" TextColor="White" Padding="12,10" />
                <Label Text="Recepciones" FontSize="14" TextColor="White" Padding="12,10" />
                <Label Text="Ventas" FontSize="14" TextColor="White" Padding="12,10" />
                <Label Text="Productos" FontSize="14" TextColor="White" Padding="12,10" />

                <VerticalStackLayout Margin="0,20,0,0" Spacing="8">
                    <Label Text="Patio operativo" FontSize="12" TextColor="#DAD7D3" />
                    <Label Text="Bella Vista, Corrientes" FontSize="12" TextColor="#E5E5E5" />
                    <Label Text="Jornada en curso" FontSize="12" TextColor="#DAD7D3" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Column="1" Padding="24,18">
            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="MIÉRCOLES · JORNADA DE TRABAJO" FontSize="11" TextColor="#6E7A76" Margin="0,16,0,0" />
                        <Label Text="Buen día, equipo." FontSize="36" FontAttributes="Bold" TextColor="#1E3D39" />
                        <Label Text="Este es el pulso del aserradero para hoy." FontSize="16" TextColor="#4A5D59" />
                    </VerticalStackLayout>

                    <Button Text=" + Registrar ingreso " HeightRequest="42" WidthRequest="190" VerticalOptions="Center" BackgroundColor="#1E4039" />
                </Grid>

                <CollectionView ItemsSource="{Binding Stats}" HeightRequest="150" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F8F5F1" Stroke="#D7D0C8" StrokeThickness="1" Padding="18,16" Margin="6" WidthRequest="210" HeightRequest="120">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border WidthRequest="28" HeightRequest="28" BackgroundColor="#E5E1DA" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                            <Label Text="{Binding Icon}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="14" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="14" TextColor="#4B5E59" Margin="8,0,0,0" VerticalTextAlignment="Center" />
                                    </Grid>

                                    <Label Text="{Binding Value}" FontSize="36" FontAttributes="Bold" TextColor="#1E3C35" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#697A75" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Grid.Column="0" BackgroundColor="#F8F5F1" Stroke="#D7D0C8" StrokeThickness="1" Padding="18,16">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Actividad reciente" FontSize="20" FontAttributes="Bold" TextColor="#2A3D39" />
                            <Label Text="Ingresos y salidas del patio" FontSize="12" TextColor="#5D7069" />

                            <CollectionView ItemsSource="{Binding RecentActivity}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="0,10">
                                            <Border WidthRequest="28" HeightRequest="28" BackgroundColor="#DDE8E1" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                                <Label Text="↥" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#1E4039" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0">
                                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                                <Label Text="{Binding Location}" FontSize="12" TextColor="#5C706A" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2" Text="{Binding Delta}" FontSize="14" FontAttributes="Bold" TextColor="#2C6148" Margin="8,0" />
                                            <Label Grid.Column="3" Text="{Binding Date}" FontSize="12" TextColor="#6A7B75" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#F8F5F1" Stroke="#D7D0C8" StrokeThickness="1" Padding="18,16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Stock por producto" FontSize="20" FontAttributes="Bold" TextColor="#2A3D39" />
                                <Label Grid.Column="1" Text="›" FontSize="18" TextColor="#6B7A73" />
                            </Grid>

                            <Label Text="Los mínimos que requieren atención" FontSize="12" TextColor="#5D7069" />

                            <CollectionView ItemsSource="{Binding StockProducts}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="4" Padding="0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Product}" FontAttributes="Bold" FontSize="14" />
                                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='{0} u'}" FontSize="12" TextColor="#5F756E" />
                                            </Grid>

                                            <Border HeightRequest="10" StrokeThickness="0" BackgroundColor="#E4E0D9" StrokeShape="RoundRectangle 8">
                                                <Border WidthRequest="100" BackgroundColor="{Binding Color}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="#F8F5F1" Stroke="#D7D0C8" StrokeThickness="1" Padding="18,16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Reposición sugerida" FontSize="22" FontAttributes="Bold" TextColor="#213D39" />
                            <Label Grid.Column="1" Text="1 para revisar" FontSize="12" TextColor="#D55B4C" BackgroundColor="#F6E6E3" Padding="8,4" />
                        </Grid>

                        <Label Text="Unidades iguales o por debajo del mínimo definido" FontSize="12" TextColor="#5D7069" />

                        <Grid ColumnDefinitions="2.4*,1.3*,1.2*,1.2*,1.2*" Padding="0,8">
                            <Label Text="PRODUCTO" FontSize="11" FontAttributes="Bold" TextColor="#465B56" />
                            <Label Grid.Column="1" Text="ESPECIE" FontSize="11" FontAttributes="Bold" TextColor="#465B56" />
                            <Label Grid.Column="2" Text="DISPONIBLE" FontSize="11" FontAttributes="Bold" TextColor="#465B56" />
                            <Label Grid.Column="3" Text="MÍNIMO" FontSize="11" FontAttributes="Bold" TextColor="#465B56" />
                            <Label Grid.Column="4" Text="ESTADO" FontSize="11" FontAttributes="Bold" TextColor="#465B56" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding RepositionItems}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2.4*,1.3*,1.2*,1.2*,1.2*" Padding="0,10">
                                        <Label Text="{Binding Product}" FontSize="14" />
                                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#E8F0EB" Padding="6,4" HorizontalOptions="Start" StrokeShape="RoundRectangle 10">
                                            <Label Text="{Binding Species}" FontSize="12" TextColor="#2A4C40" />
                                        </Border>
                                        <Label Grid.Column="2" Text="{Binding Available}" FontSize="14" />
                                        <Label Grid.Column="3" Text="{Binding Minimum}" FontSize="14" />
                                        <Border Grid.Column="4" Padding="8,4" BackgroundColor="#F3DCD5" StrokeThickness="0" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                            <Label Text="{Binding Status}" FontSize="12" TextColor="#9A4A39" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
