<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonteClaroAdmin.Views.SalesPage"
             BackgroundColor="#F4F0EB">
    <VerticalStackLayout Padding="24" Spacing="18">
        <Label Text="Ventas" FontSize="32" FontAttributes="Bold" TextColor="#1E4039" />
        <Label Text="Resumen del movimiento comercial" FontSize="14" TextColor="#5F756E" />

        <CollectionView ItemsSource="{Binding Sales}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#D7D0C8" StrokeThickness="1" Padding="16,12" Margin="0,0,0,10" BackgroundColor="#F8F5F1">
                        <Grid ColumnDefinitions="2*,1.5*,1.2*">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Client}" FontSize="12" TextColor="#5F756E" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Date}" FontSize="14" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="{Binding Total, StringFormat='${0:N0}'}" FontAttributes="Bold" FontSize="14" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
