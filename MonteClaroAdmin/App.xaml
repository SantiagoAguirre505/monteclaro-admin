<?xml version = "1.0" encoding = "utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MonteClaroAdmin"
             x:Class="MonteClaroAdmin.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryGreen">#1E4039</Color>
            <Color x:Key="PrimaryGreenDark">#15362F</Color>
            <Color x:Key="PrimaryGreenSoft">#2E5A4E</Color>
            <Color x:Key="AccentGreen">#7BAA8E</Color>
            <Color x:Key="WarmBeige">#F4F0EB</Color>
            <Color x:Key="CardBeige">#F8F5F1</Color>
            <Color x:Key="LineGray">#D9D1C7</Color>
            <Color x:Key="TextPrimary">#1F2A2A</Color>
            <Color x:Key="TextMuted">#68736E</Color>
            <Color x:Key="Warning">#D9694A</Color>
            <Color x:Key="Success">#7AA77F</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
